node_modules/
out/
dist/
dist-electron/
release/
# Secrets. The bare name was not enough: .env.local, .env.production and any
# .env.<something>-backup fall outside it, and one of those holding a Turso
# auth token was a `git add -A` away from being committed. The example file is
# the template and stays tracked.
.env
.env.*
!.env.example
*.log
.DS_Store

*.tsbuildinfo

# scratch harness/cleanup scripts
_*.cjs
_*.js
src/main/_*.ts

# Web server: build output, local SQLite data, and dev logs
/out/web/
/out/server/
/.server-data/
/data/
web*.log
web*.err
weblite.log
weblite.err
webshared.log
webshared.err

# Web deployment bundle (generated by npm run web:pack)
/deploy/
