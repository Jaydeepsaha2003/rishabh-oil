# Copy this file to .env and paste your Turso auth token.
# The .env file is git-ignored and never leaves your machine.

# Used in development (npm run dev) and by `npm run db:test`.
TURSO_DATABASE_URL=libsql://rishabh-oil-rishabh008.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=

# Baked into the installers (npm run dist:win / dist:mac) so the installed
# app on each machine connects without needing a .env. Keep these in sync.
MAIN_VITE_TURSO_DATABASE_URL=libsql://rishabh-oil-rishabh008.aws-ap-south-1.turso.io
MAIN_VITE_TURSO_AUTH_TOKEN=
